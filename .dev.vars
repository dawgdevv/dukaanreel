# DukaanReel — single .env for all (Next + Wrangler)
# Wrangler reads .dev.vars, Next reads .env/.env.local — this file is source, copy on start

# Photo → Clean studio
REMOVE_BG_API_KEY=your_remove_bg_api_key_here
# https://www.remove.bg/api

# Voice — ElevenLabs Hinglish (Multilingual v2)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# https://elevenlabs.io/app/settings/api-keys

# Caption — GPT-4o vision (optional)
OPENAI_API_KEY=your_openai_api_key_here

# Cloudflare R2 public URL
NEXT_PUBLIC_R2_PUBLIC_URL=https://your-public-bucket.r2.dev
